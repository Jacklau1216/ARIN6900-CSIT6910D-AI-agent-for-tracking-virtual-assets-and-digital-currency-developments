# AI provider configuration for the MVP workflow.
# Copy this file to .env and update the values for your local or hosted model.

AI_ENABLED=true
AI_PROVIDER=openai_compatible
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60

# Ollama (optional, if you switch back to local mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible API (HKUST custom endpoint setup)
OPENAI_COMPATIBLE_BASE_URL=https://hkust.azure-api.net/hkust-genai-auth/v1/
OPENAI_COMPATIBLE_API_KEY=your_key_here
OPENAI_COMPATIBLE_MODEL=gpt-5.6-luna
